# Environment Configuration Template
# Copy this file to .env and fill in your values

# ==================== SERVER ====================
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recipe_app
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ==================== SPRING ====================
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ==================== JWT ====================
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
JWT_EXPIRATION_MS=86400000

# ==================== EMAIL ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@recipeapp.com

# ==================== FRONTEND ====================
REACT_APP_API_URL=http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# ==================== CORS ====================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=logs/recipe-app.log

# ==================== ENVIRONMENT ====================
ENVIRONMENT=development
DEBUG=false

# ==================== FILE UPLOAD ====================
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE=5242880

# ==================== PAGINATION ====================
PAGE_DEFAULT_SIZE=20
PAGE_MAX_SIZE=100

# ==================== FEATURES ====================
FEATURE_EMAIL_VERIFICATION=false
FEATURE_SOCIAL_LOGIN=false
FEATURE_EXPORT_SHOPPING_LIST=true

# ==================== SECURITY ====================
BCRYPT_STRENGTH=10
SESSION_TIMEOUT_MINUTES=30

# ==================== ACTUATOR ====================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics,env
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when_authorized

# ==================== CACHE ====================
CACHE_ENABLED=true
CACHE_TTL_MINUTES=30

# ==================== DOCUMENTATION ====================
SWAGGER_ENABLED=true
SWAGGER_UI_PATH=/swagger-ui.html
API_DOCS_PATH=/v3/api-docs

# ==================== AWS (Optional) ====================
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=recipe-app-bucket
AWS_REGION=us-east-1

# ==================== STRIPE (Optional) ====================
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLIC_KEY=pk_test_your_key_here

# ==================== SENTRY (Optional) ====================
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
